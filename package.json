{
  "name": "cdawg-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:production": "npm run typecheck && node scripts/build-production.mjs",
    "start": "node build/server/index.js",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:production": "node scripts/test-production.mjs",
    "db:migrate": "node build/server/database/cli.js migrate",
    "db:status": "node build/server/database/cli.js status",
    "test:database": "node scripts/test-database.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "8.23.0",
    "phaser": "^3.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.20.0"
  }
}
