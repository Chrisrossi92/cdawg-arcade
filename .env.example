# Safe public template only. Copy to .env and configure locally; never commit .env.
# Every value below is a placeholder, not a working configuration.
# Browser practice: use a plain browser URL; no Discord secrets are needed.
# VITE_DISCORD_ENABLED is a legacy flag; complete SDK launch context selects Discord mode.
# Use the same application client ID for the frontend and backend.
VITE_DISCORD_CLIENT_ID=replace-with-discord-application-client-id
VITE_DISCORD_ENABLED=replace-with-false-for-browser-or-true-for-discord
VITE_APP_VERSION=replace-with-local-app-version-label
VITE_API_BASE_URL=replace-with-api-base-path

# Backend only: NEVER use a VITE_ prefix for secrets.
# Use the current Discord client secret locally; never restore a revoked credential.
DISCORD_CLIENT_ID=replace-with-discord-application-client-id
DISCORD_CLIENT_SECRET=replace-with-new-discord-client-secret
DISCORD_REDIRECT_URI=replace-with-registered-discord-oauth-redirect-uri
SERVER_PORT=replace-with-local-backend-port
ALLOWED_ORIGINS=replace-with-comma-separated-allowed-browser-origins

# Production only; set in Render rather than copying a local .env.
# PORT overrides SERVER_PORT; Render supplies PORT. HOST defaults to 0.0.0.0 in production.
NODE_ENV=replace-with-production
PORT=replace-with-platform-port
HOST=replace-with-bind-ip-address
# Full source SHA (Render supplies RENDER_GIT_COMMIT instead); development-* is for local tests only.
RELEASE_SHA=replace-with-full-source-commit-sha

# Persistence foundation: server-only; no official scoring exists in this phase.
DATABASE_URL=replace-with-private-postgres-url
PERSISTENCE_CONFIGURED=replace-with-false-until-configured
OFFICIAL_SCORING_ENABLED=replace-with-false
DATABASE_TLS_MODE=replace-with-verify-full-or-render-internal
DATABASE_POOL_MAX=replace-with-5
DATABASE_CONNECT_TIMEOUT_MS=replace-with-1500
DATABASE_STATEMENT_TIMEOUT_MS=replace-with-2000

# Phase 4C: server-only, independent of scoring. Leave disabled until live acceptance.
ARCADE_SESSIONS_ENABLED=false
DISCORD_ARCADE_BOT_TOKEN=replace-with-arcade-only-bot-token
# DATABASE_URL must use the restricted arcade_session_runtime role before enabling sessions.
# Administrative connection stays with the owner/provider, not in application variables.

# Temporary canary diagnostic only; incorrect-verifier exchange must fail closed.
ARCADE_PKCE_PROBE_ENABLED=false

# Phase 4D backend foundation only: leave disabled until the complete official flow is ready.
# Existing production role deliberately lacks attempt-write privileges. No automatic registration/grants.
ARCADE_ATTEMPTS_ENABLED=false
