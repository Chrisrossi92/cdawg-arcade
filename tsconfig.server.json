{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "rootDir": "server", "outDir": "build/server",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "sourceMap": false, "declaration": false
  },
  "include": ["server/**/*.ts"], "exclude": ["server/**/*.test.ts"]
}
